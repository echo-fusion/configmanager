{
    "name": "echo-fusion/configmanager",
    "description": "Immutable, deeply merged application configuration with dot-notation access for the EchoFusion framework.",
    "keywords": [
        "config",
        "configuration",
        "echofusion"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/echo-fusion/configmanager",
    "authors": [
        {
            "name": "Amir Shadanfar",
            "email": "a.shadanfar.it@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/echo-fusion/configmanager/issues",
        "source": "https://github.com/echo-fusion/configmanager"
    },
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0",
        "echo-fusion/contracts": "^1.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "vimeo/psalm": "^5.26",
        "friendsofphp/php-cs-fixer": "^3.64",
        "echo-fusion/codestandard": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "EchoFusion\\ConfigManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EchoFusion\\ConfigManager\\Tests\\": "tests"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "test": [
            "@cs-check",
            "@analyze",
            "@phpunit"
        ],
        "phpunit": "vendor/bin/phpunit",
        "test:coverage:text": "vendor/bin/phpunit --coverage-text",
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "analyze": "psalm --show-info=false --no-cache --no-progress"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
